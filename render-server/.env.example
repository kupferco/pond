# Copy to .env and `set -a; source .env; set +a` before running locally.

# Public base URL of this server (no trailing slash). Used for OAuth metadata and links.
POND_PUBLIC_URL=http://localhost:8080
POND_HOST=127.0.0.1
POND_PORT=8080

# Where renders are kept: "local:<dir>" or "gs://<bucket>[/<prefix>]"
POND_STORAGE=local:./renders

# Auth: "token" (static bearer token, for local tests / API use) or "oauth" (built-in
# password-protected OAuth server, for the Claude custom connector). "none" is allowed
# only for localhost.
POND_AUTH_MODE=token
POND_API_TOKEN=change-me

# OAuth mode settings. The password is what you type in the browser when Claude connects.
# The signing secret signs tokens; rotate it to log every client out.
POND_OAUTH_PASSWORD=
POND_OAUTH_SIGNING_SECRET=

# Sandbox limits for CadQuery scripts
POND_CAD_TIMEOUT_S=60
POND_CAD_MEMORY_MB=3072
